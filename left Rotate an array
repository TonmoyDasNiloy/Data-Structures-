# Original list of integers
number_list = [1, 2, 3, 4, 5, 6, 7]

# Input: number of positions to rotate left
rotation_count = int(input("Enter the number of positions to rotate left: "))

# Perform left rotation one step at a time
for _ in range(rotation_count):
    # Store the first element temporarily
    first_element = number_list[0]
    
    # Shift all elements to the left by one position
    for index in range(1, len(number_list)):
        number_list[index - 1] = number_list[index]
    
    # Place the first element at the end
    number_list[-1] = first_element

# Print the updated list after rotation
print("List after left rotation:", number_list)
