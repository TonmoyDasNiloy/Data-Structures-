# Read the number of elements to store in the list
num_elements = int(input("Enter the number of elements: "))

# Initialize a list of the given size with None
integer_list = [None] * num_elements

# Read each element from user input and store it in the list
for i in range(len(integer_list)):
    user_input = int(input(f"Enter element {i + 1}: "))
    integer_list[i] = user_input

# Print the final list of integers
print("The list of entered integers:", integer_list)
