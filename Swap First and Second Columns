import numpy as np

def swap_column_matrix(m):
    m = np.array(m)
    row, col = m.shape
    for i in range(row):
        m[i][0], m[i][1] = m[i][1], m[i][0]
    print("Matrix after swapping first and second columns:")
    print(m)

# Example 3x3 matrix
m = [[1, 2, 3], [5, 6, 7], [9, 10, 11]]
swap_column_matrix(m)
