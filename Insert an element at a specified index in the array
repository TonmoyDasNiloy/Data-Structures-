# Original list of integers
number_list = [1, 2, 3, 4, 5, 6]

# Input: index where the new element will be inserted
insert_index = int(input("Enter the index where the element should be inserted: "))

# Input: element to be inserted
new_element = int(input("Enter the element to insert: "))

# Shift elements to the right to make space for the new element
for index in range(len(number_list) - 1, insert_index, -1):
    number_list[index] = number_list[index - 1]

# Insert the new element at the specified index
number_list[insert_index] = new_element

# Print the updated list after insertion
print("List after insertion:", number_list)
