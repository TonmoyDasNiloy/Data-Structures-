# Original list of integers
number_list = [1, 2, 3, 4, 5, 6, 7]

# Input: number of positions to rotate right
rotation_count = int(input("Enter the number of positions to rotate right: "))

# Perform right rotation one step at a time
for _ in range(rotation_count):
    # Store the last element temporarily
    last_element = number_list[-1]
    
    # Shift all elements to the right by one position
    for index in range(len(number_list) - 2, -1, -1):
        number_list[index + 1] = number_list[index]
    
    # Place the last element at the beginning
    number_list[0] = last_element

# Print the updated list after rotation
print("List after right rotation:", number_list)
