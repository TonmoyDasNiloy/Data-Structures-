# Perform a right shift on the array
# This moves each element one position to the right and places None at the beginning

# Original list of integers
number_list = [1, 2, 3, 4, 5, 6, 7]

# Shift elements to the right by one position
for index in range(len(number_list) - 2, -1, -1):
    number_list[index + 1] = number_list[index]

# Set the first element to None after the shift
number_list[0] = None

# Print the updated list after right shift
print("List after right shift:", number_list)
